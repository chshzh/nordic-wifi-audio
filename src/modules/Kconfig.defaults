# GATEWAY
if AUDIO_GATEWAY = y

if AUDIO_SOURCE_USB

# UAC2 on the USBD-next / UDC stack (replaces the legacy USB_DEVICE_STACK).
# Enabled only for the gateway role (this block is inside `if AUDIO_GATEWAY`).
config USB_DEVICE_STACK_NEXT
	default y

config USBD_AUDIO2_CLASS
	default y

# Net buf is required by the UDC stack.
config NET_BUF
	default y

## Avoid redundant warnings from the USBD/UDC stack
config USBD_LOG_LEVEL
	default 1

config UDC_DRIVER_LOG_LEVEL
	default 1

# The UAC2 class logs "request ep 0x.. len 0 cancelled" at WRN every time a
# 1 ms isochronous OUT slot arrives empty (routine on a synchronous endpoint
# when the host does not fill every frame). Audio is unaffected; drop the class
# log level to ERR to silence the spam.
config USBD_UAC2_LOG_LEVEL
	default 1

endif # AUDIO_SOURCE_USB

endif # AUDIO_DEV = 2 (GATEWAY)
